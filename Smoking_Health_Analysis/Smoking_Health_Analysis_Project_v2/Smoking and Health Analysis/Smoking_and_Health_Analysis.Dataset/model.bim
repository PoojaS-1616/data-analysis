            "sourceColumn": "Diastolic_BP_mmHg",
            "summarizeBy": "sum"
          },
          {
            "name": "BMI",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "3cb4be2d-9992-4b24-a439-e73a6ab5596e",
            "sourceColumn": "BMI",
            "summarizeBy": "sum"
          },
          {
            "name": "Resting_Heart_Rate_bpm",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "41ab2817-e837-4831-8687-bc7335633d16",
            "sourceColumn": "Resting_Heart_Rate_bpm",
            "summarizeBy": "sum"
          },
          {
            "name": "Age Group",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Age] < 30, \"18–29\", 'Smoking_Health_Analysis'[Age] < 45, \"30–44\", 'Smoking_Health_Analysis'[Age] < 60, \"45–59\", \"60+\")",
            "isDataTypeInferred": true,
            "lineageTag": "a3584860-0157-4a9c-a080-4952a831a0ee",
            "sortByColumn": "Age Group Sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Age Group Sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Age] < 30, 1, 'Smoking_Health_Analysis'[Age] < 45, 2, 'Smoking_Health_Analysis'[Age] < 60, 3, 4)",
            "isDataTypeInferred": true,
            "lineageTag": "12ddf4d4-4338-4374-b457-fc32d807bf5a",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "BP Risk Category",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 130 || 'Smoking_Health_Analysis'[Diastolic_BP_mmHg] >= 80, \"High\", 'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 120 && 'Smoking_Health_Analysis'[Diastolic_BP_mmHg] < 80, \"Elevated\", \"Lower Range\")",
            "isDataTypeInferred": true,
            "lineageTag": "5c2e4954-20e6-4f67-9eb5-dce84d0deb59",
            "sortByColumn": "BP Risk Sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "BP Risk Sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 130 ||",
              "    'Smoking_Health_Analysis'[Diastolic_BP_mmHg] >= 80, 3,",
              "",
              "    'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 120 &&",
              "    'Smoking_Health_Analysis'[Diastolic_BP_mmHg] < 80, 2,",
              "",
              "    1",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "126b0ce2-faf0-4669-8b66-ddc1c40d67b8",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Pack Years",
            "dataType": "double",
            "expression": "('Smoking_Health_Analysis'[Cigarettes_Per_Day] / 20) * 'Smoking_Health_Analysis'[Years_Smoking]",
            "formatString": "#,##0.00",
            "isDataTypeInferred": true,
            "lineageTag": "a3e9e371-c2b9-47f0-9b4f-0f198659847f",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Exposure Category",
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "string",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Smoking_Status] = \"Never Smoked\", \"Never Smoked\", 'Smoking_Health_Analysis'[Pack Years] = 0, \"Former Smokers (0 Current PY)\", 'Smoking_Health_Analysis'[Pack Years] < 10, \"Light (<10 Pack-Years)\", 'Smoking_Health_Analysis'[Pack Years] < 20, \"Moderate (10–19.9 Pack-Years)\", \"Heavy (20+ Pack-Years)\")",
            "isDataTypeInferred": true,
            "lineageTag": "91bbfa80-1ad9-447b-99c3-35acc4290226",
            "sortByColumn": "Exposure Sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Exposure Sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    'Smoking_Health_Analysis'[Smoking_Status] = \"Never Smoked\", 1,",
              "    'Smoking_Health_Analysis'[Pack Years] = 0, 2,",
              "    'Smoking_Health_Analysis'[Pack Years] < 10, 3,",
              "    'Smoking_Health_Analysis'[Pack Years] < 20, 4,",
              "    5",
              ")"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "ad11024b-a47b-4771-adb4-8aadc4cec4ed",
            "summarizeBy": "sum",
            "type": "calculated"
          }
        ],
        "lineageTag": "e87a6935-10b8-4ee6-ae7d-640883d110a8",
        "partitions": [
          {
            "name": "Smoking_Health_Analysis",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(",
                "        File.Contents(\"C:/Users/pooja/Downloads/Smoking and Health Analysis/Smoking_Health_Analysis.csv\"),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                "    ),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{",
                "        {\"Patient_ID\", type text},",
                "        {\"Age\", Int64.Type},",
                "        {\"Gender\", type text},",
                "        {\"Region\", type text},",
                "        {\"Diagnosis_Date\", type date},",
                "        {\"Smoking_Status\", type text},",
                "        {\"Cigarettes_Per_Day\", type number},",
                "        {\"Years_Smoking\", type number},",
                "        {\"Diagnosed_Organ\", type text},",
                "        {\"Health_Condition\", type text},",
                "        {\"Total_Cholesterol_mg_dL\", type number},",
                "        {\"Systolic_BP_mmHg\", type number},",
                "        {\"Diastolic_BP_mmHg\", type number},",
                "        {\"BMI\", type number},",
                "        {\"Resting_Heart_Rate_bpm\", type number}",
                "    })",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "isNameInferred": true,
            "lineageTag": "93f1b481-bcb0-4bae-895b-dfba306673a8",
            "sourceColumn": "[Value]",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "584298f3-b4e3-4e62-bf50-a90673d3b1b9",
        "measures": [
          {
            "name": "Total Patients",
            "expression": "COUNTROWS('Smoking_Health_Analysis')",
            "formatString": "#,##0",
            "lineageTag": "0d7bd427-5815-4db7-8d27-2a8ceda557e8"
          },
          {
            "name": "Total Current Smokers",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS('Smoking_Health_Analysis'),",
              "    'Smoking_Health_Analysis'[Smoking_Status] = \"Current Smoker\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "9a16b32f-85d0-4408-aa5a-0616abfb9dd9"
          },
          {
            "name": "Patients with Recorded Organ",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS('Smoking_Health_Analysis'),",
              "    'Smoking_Health_Analysis'[Diagnosed_Organ] <> \"No Recorded Organ Condition\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "e5570271-59a4-4d39-8436-4c91476f84bd"
          },
          {
            "name": "Patients with Recorded Condition",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS('Smoking_Health_Analysis'),",
              "    'Smoking_Health_Analysis'[Health_Condition] <> \"No Diagnosed Condition\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "c7b84276-94f2-4296-b032-c1b00e36f094"
          },
          {
            "name": "Smoker Prevalence Rate",
            "expression": "DIVIDE([Total Current Smokers], [Total Patients], 0)",
            "formatString": "0.00%",
            "lineageTag": "36ecaa34-69ec-49b6-974b-0813e0bb04ca"
          },
          {
            "name": "Average Cigarettes Per Day",
            "expression": "AVERAGE('Smoking_Health_Analysis'[Cigarettes_Per_Day])",
            "formatString": "#,##0.00",
            "lineageTag": "b3e23400-57a6-4c11-b273-174d4ec098e7"
          },
          {
            "name": "Average Total Cholesterol",
            "expression": "AVERAGE('Smoking_Health_Analysis'[Total_Cholesterol_mg_dL])",
            "formatString": "#,##0.00",
            "lineageTag": "f4a043c9-c2f1-4258-9d2c-6a593166a0be"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": "Row(\"Value\", BLANK())",
              "type": "calculated"
            }
          }
        ]
      },
