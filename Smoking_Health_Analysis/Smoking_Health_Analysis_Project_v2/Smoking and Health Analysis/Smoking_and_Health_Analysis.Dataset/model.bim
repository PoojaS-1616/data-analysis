{
  "compatibilityLevel": 1606,
  "model": {
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataFolderPath\",\"Smoking_Health_Analysis\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ],
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "relationships": [],
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Smoking_Health_Analysis",
        "columns": [
          {
            "name": "Patient_ID",
            "dataType": "string",
            "lineageTag": "acdbff41-d0a8-48c8-9102-6c74c4bcb1ef",
            "sourceColumn": "Patient_ID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Age",
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "2e12d348-662d-4bac-8917-c0d84f475cf5",
            "sourceColumn": "Age",
            "summarizeBy": "none"
          },
          {
            "name": "Gender",
            "dataType": "string",
            "lineageTag": "bc1e39df-d39e-4b85-bac5-66e201f8bc21",
            "sourceColumn": "Gender",
            "summarizeBy": "none"
          },
          {
            "name": "Region",
            "dataType": "string",
            "lineageTag": "e1167138-8ec5-4dbc-b1bc-3e788027406f",
            "sourceColumn": "Region",
            "summarizeBy": "none"
          },
          {
            "name": "Diagnosis_Date",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "a14d0522-4b69-4137-af89-d0589f78fcc5",
            "sourceColumn": "Diagnosis_Date",
            "summarizeBy": "none"
          },
          {
            "name": "Smoking_Status",
            "dataType": "string",
            "lineageTag": "3a732295-a003-49ed-9913-319ce2b1b53f",
            "sourceColumn": "Smoking_Status",
            "summarizeBy": "none"
          },
          {
            "name": "Cigarettes_Per_Day",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "7e8f6b86-79e9-4f7e-8238-e34d9351b46b",
            "sourceColumn": "Cigarettes_Per_Day",
            "summarizeBy": "none"
          },
          {
            "name": "Years_Smoking",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "412f4719-8358-46ec-a8dc-856170386007",
            "sourceColumn": "Years_Smoking",
            "summarizeBy": "none"
          },
          {
            "name": "Diagnosed_Organ",
            "dataType": "string",
            "lineageTag": "a49063a4-3a65-4cd1-8d1c-b66a04dae923",
            "sourceColumn": "Diagnosed_Organ",
            "summarizeBy": "none"
          },
          {
            "name": "Health_Condition",
            "dataType": "string",
            "lineageTag": "8489b537-3ba1-47f0-930e-77d3ce89394a",
            "sourceColumn": "Health_Condition",
            "summarizeBy": "none"
          },
          {
            "name": "Total_Cholesterol_mg_dL",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "498c98b9-c15d-4a0d-94f4-2e03f0085c97",
            "sourceColumn": "Total_Cholesterol_mg_dL",
            "summarizeBy": "none"
          },
          {
            "name": "Systolic_BP_mmHg",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "d46d74ef-d8e5-4f7d-9435-30481518dd22",
            "sourceColumn": "Systolic_BP_mmHg",
            "summarizeBy": "none"
          },
          {
            "name": "Diastolic_BP_mmHg",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "ac49aec2-9a72-4ec9-9204-f3c5b52f8a13",
            "sourceColumn": "Diastolic_BP_mmHg",
            "summarizeBy": "none"
          },
          {
            "name": "BMI",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "3cb4be2d-9992-4b24-a439-e73a6ab5596e",
            "sourceColumn": "BMI",
            "summarizeBy": "none"
          },
          {
            "name": "Resting_Heart_Rate_bpm",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "41ab2817-e837-4831-8687-bc7335633d16",
            "sourceColumn": "Resting_Heart_Rate_bpm",
            "summarizeBy": "none"
          },
          {
            "name": "Age Group",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Age] < 30, \"18–29\", 'Smoking_Health_Analysis'[Age] < 45, \"30–44\", 'Smoking_Health_Analysis'[Age] < 60, \"45–59\", \"60+\")",
            "isDataTypeInferred": true,
            "lineageTag": "a3584860-0157-4a9c-a080-4952a831a0ee",
            "sortByColumn": "Age Group Sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Age Group Sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Age] < 30, 1, 'Smoking_Health_Analysis'[Age] < 45, 2, 'Smoking_Health_Analysis'[Age] < 60, 3, 4)",
            "isDataTypeInferred": true,
            "lineageTag": "12ddf4d4-4338-4374-b457-fc32d807bf5a",
            "summarizeBy": "none",
            "type": "calculated",
            "isHidden": true
          },
          {
            "name": "BP Risk Category",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 130 || 'Smoking_Health_Analysis'[Diastolic_BP_mmHg] >= 80, \"High\", 'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 120 && 'Smoking_Health_Analysis'[Diastolic_BP_mmHg] < 80, \"Elevated\", \"Lower Range\")",
            "isDataTypeInferred": true,
            "lineageTag": "5c2e4954-20e6-4f67-9eb5-dce84d0deb59",
            "sortByColumn": "BP Risk Sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "BP Risk Sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 130 ||",
              "    'Smoking_Health_Analysis'[Diastolic_BP_mmHg] >= 80, 3,",
              "",
              "    'Smoking_Health_Analysis'[Systolic_BP_mmHg] >= 120 &&",
              "    'Smoking_Health_Analysis'[Diastolic_BP_mmHg] < 80, 2,",
              "",
              "    1",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "126b0ce2-faf0-4669-8b66-ddc1c40d67b8",
            "summarizeBy": "none",
            "type": "calculated",
            "isHidden": true
          },
          {
            "name": "Pack Years",
            "dataType": "double",
            "expression": "('Smoking_Health_Analysis'[Cigarettes_Per_Day] / 20) * 'Smoking_Health_Analysis'[Years_Smoking]",
            "formatString": "#,##0.00",
            "isDataTypeInferred": true,
            "lineageTag": "a3e9e371-c2b9-47f0-9b4f-0f198659847f",
            "summarizeBy": "none",
            "type": "calculated",
            "description": "Calculated as (Cigarettes_Per_Day / 20) * Years_Smoking. Caveat: Former Smokers have Cigarettes_Per_Day = 0 in source data despite 16.18 avg smoking years; 0 does not represent zero lifetime exposure."
          },
          {
            "name": "Exposure Category",
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "string",
            "expression": "SWITCH(TRUE(), 'Smoking_Health_Analysis'[Smoking_Status] = \"Never Smoked\", \"Never Smoked\", 'Smoking_Health_Analysis'[Pack Years] = 0, \"Former Smokers (0 Current PY)\", 'Smoking_Health_Analysis'[Pack Years] < 10, \"Light (<10 Pack-Years)\", 'Smoking_Health_Analysis'[Pack Years] < 20, \"Moderate (10–19.9 Pack-Years)\", \"Heavy (20+ Pack-Years)\")",
            "isDataTypeInferred": true,
            "lineageTag": "91bbfa80-1ad9-447b-99c3-35acc4290226",
            "sortByColumn": "Exposure Sort",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Exposure Sort",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    'Smoking_Health_Analysis'[Smoking_Status] = \"Never Smoked\", 1,",
              "    'Smoking_Health_Analysis'[Pack Years] = 0, 2,",
              "    'Smoking_Health_Analysis'[Pack Years] < 10, 3,",
              "    'Smoking_Health_Analysis'[Pack Years] < 20, 4,",
              "    5",
              ")"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "ad11024b-a47b-4771-adb4-8aadc4cec4ed",
            "summarizeBy": "none",
            "type": "calculated",
            "isHidden": true
          },
          {
            "name": "BP Anomaly Flag",
            "dataType": "string",
            "description": "Flags the 49 records where Diastolic_BP_mmHg >= Systolic_BP_mmHg without deleting or altering source data.",
            "expression": "IF('Smoking_Health_Analysis'[Diastolic_BP_mmHg] >= 'Smoking_Health_Analysis'[Systolic_BP_mmHg], \"Diastolic >= Systolic\", \"Valid (Systolic > Diastolic)\")",
            "isDataTypeInferred": true,
            "lineageTag": "f1b2c3d4-5e6f-4789-9abc-def012345678",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "e87a6935-10b8-4ee6-ae7d-640883d110a8",
        "partitions": [
          {
            "name": "Smoking_Health_Analysis",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    FolderPath = Text.TrimEnd(Text.Replace(DataFolderPath, \"\\\", \"/\"), \"/\"),",
                "    Source = Csv.Document(",
                "        File.Contents(FolderPath & \"/Smoking_Health_Analysis.csv\"),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                "    ),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{",
                "        {\"Patient_ID\", type text},",
                "        {\"Age\", Int64.Type},",
                "        {\"Gender\", type text},",
                "        {\"Region\", type text},",
                "        {\"Diagnosis_Date\", type date},",
                "        {\"Smoking_Status\", type text},",
                "        {\"Cigarettes_Per_Day\", type number},",
                "        {\"Years_Smoking\", type number},",
                "        {\"Diagnosed_Organ\", type text},",
                "        {\"Health_Condition\", type text},",
                "        {\"Total_Cholesterol_mg_dL\", type number},",
                "        {\"Systolic_BP_mmHg\", type number},",
                "        {\"Diastolic_BP_mmHg\", type number},",
                "        {\"BMI\", type number},",
                "        {\"Resting_Heart_Rate_bpm\", type number}",
                "    })",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "isNameInferred": true,
            "lineageTag": "93f1b481-bcb0-4bae-895b-dfba306673a8",
            "sourceColumn": "[Value]",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "584298f3-b4e3-4e62-bf50-a90673d3b1b9",
        "measures": [
          {
            "name": "Total Patients",
            "description": "Total patient records in the active filter context.",
            "expression": "COALESCE(COUNTROWS('Smoking_Health_Analysis'), 0)",
            "formatString": "#,##0",
            "lineageTag": "0d7bd427-5815-4db7-8d27-2a8ceda557e8"
          },
          {
            "name": "Total Current Smokers",
            "description": "Count of Current Smoker records respecting active slicers via KEEPFILTERS.",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('Smoking_Health_Analysis'),",
              "        KEEPFILTERS('Smoking_Health_Analysis'[Smoking_Status] = \"Current Smoker\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "9a16b32f-85d0-4408-aa5a-0616abfb9dd9"
          },
          {
            "name": "Total Former Smokers",
            "description": "Count of Former Smoker records respecting active slicers via KEEPFILTERS.",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('Smoking_Health_Analysis'),",
              "        KEEPFILTERS('Smoking_Health_Analysis'[Smoking_Status] = \"Former Smoker\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a01"
          },
          {
            "name": "Total Never Smokers",
            "description": "Count of Never Smoked records respecting active slicers via KEEPFILTERS.",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('Smoking_Health_Analysis'),",
              "        KEEPFILTERS('Smoking_Health_Analysis'[Smoking_Status] = \"Never Smoked\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a02"
          },
          {
            "name": "Patients with Recorded Organ",
            "description": "Count of records with a recorded organ category, preserving active slicers via KEEPFILTERS.",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('Smoking_Health_Analysis'),",
              "        KEEPFILTERS('Smoking_Health_Analysis'[Diagnosed_Organ] <> \"No Recorded Organ Condition\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "e5570271-59a4-4d39-8436-4c91476f84bd"
          },
          {
            "name": "Patients with Recorded Condition",
            "description": "Count of records with a recorded health condition, preserving active slicers via KEEPFILTERS.",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('Smoking_Health_Analysis'),",
              "        KEEPFILTERS('Smoking_Health_Analysis'[Health_Condition] <> \"No Diagnosed Condition\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "c7b84276-94f2-4296-b032-c1b00e36f094"
          },
          {
            "name": "Smoker Prevalence Rate",
            "description": "Current smokers divided by total records in the active filter context.",
            "expression": "DIVIDE([Total Current Smokers], [Total Patients], 0)",
            "formatString": "0.00%",
            "lineageTag": "36ecaa34-69ec-49b6-974b-0813e0bb04ca"
          },
          {
            "name": "Recorded Organ Rate",
            "description": "Share of records with a recorded organ category in the active filter context.",
            "expression": "DIVIDE([Patients with Recorded Organ], [Total Patients], 0)",
            "formatString": "0.00%",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a03"
          },
          {
            "name": "Recorded Condition Rate",
            "description": "Share of records with a recorded health condition in the active filter context.",
            "expression": "DIVIDE([Patients with Recorded Condition], [Total Patients], 0)",
            "formatString": "0.00%",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a04"
          },
          {
            "name": "Average Cigarettes Per Day",
            "description": "Mean Cigarettes_Per_Day across all records in filter context (includes 0s for Former and Never Smokers).",
            "expression": "AVERAGE('Smoking_Health_Analysis'[Cigarettes_Per_Day])",
            "formatString": "#,##0.00",
            "lineageTag": "b3e23400-57a6-4c11-b273-174d4ec098e7"
          },
          {
            "name": "Avg Cigarettes Per Day (Current Smokers)",
            "description": "Mean Cigarettes_Per_Day restricted to Current Smokers (17.11 overall); isolates current intensity from 0-coded Former/Never Smokers.",
            "expression": [
              "CALCULATE(",
              "    AVERAGE('Smoking_Health_Analysis'[Cigarettes_Per_Day]),",
              "    KEEPFILTERS('Smoking_Health_Analysis'[Smoking_Status] = \"Current Smoker\")",
              ")"
            ],
            "formatString": "#,##0.00",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a05"
          },
          {
            "name": "Average Total Cholesterol",
            "description": "Mean Total_Cholesterol_mg_dL in the active filter context.",
            "expression": "AVERAGE('Smoking_Health_Analysis'[Total_Cholesterol_mg_dL])",
            "formatString": "#,##0.00",
            "lineageTag": "f4a043c9-c2f1-4258-9d2c-6a593166a0be"
          },
          {
            "name": "Average Resting Heart Rate",
            "description": "Mean Resting_Heart_Rate_bpm in the active filter context.",
            "expression": "AVERAGE('Smoking_Health_Analysis'[Resting_Heart_Rate_bpm])",
            "formatString": "#,##0.00",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a06"
          },
          {
            "name": "Average Systolic BP",
            "description": "Mean Systolic_BP_mmHg in the active filter context.",
            "expression": "AVERAGE('Smoking_Health_Analysis'[Systolic_BP_mmHg])",
            "formatString": "#,##0.00",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a07"
          },
          {
            "name": "High BP Patients",
            "description": "Count of records classified as High BP under the primary project rule (Sys >= 130 or Dia >= 80).",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('Smoking_Health_Analysis'),",
              "        KEEPFILTERS('Smoking_Health_Analysis'[BP Risk Category] = \"High\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a08"
          },
          {
            "name": "High BP Rate",
            "description": "Share of records classified as High BP under the primary project rule.",
            "expression": "DIVIDE([High BP Patients], [Total Patients], 0)",
            "formatString": "0.00%",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a09"
          },
          {
            "name": "BP Anomaly Records",
            "description": "Count of records where Diastolic_BP_mmHg >= Systolic_BP_mmHg (49 overall); preserved for data-quality transparency.",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('Smoking_Health_Analysis'),",
              "        KEEPFILTERS('Smoking_Health_Analysis'[BP Anomaly Flag] = \"Diastolic >= Systolic\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "b201e4a0-1c2d-4e3f-8a9b-0c1d2e3f4a10"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": "Row(\"Value\", BLANK())",
              "type": "calculated"
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataFolderPath",
        "description": "Portable folder path containing Smoking_Health_Analysis.csv. Set via Transform data -> Edit parameters in Power BI Desktop.",
        "expression": [
          "\"REPLACE_WITH_LOCAL_PROJECT_FOLDER_PATH\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ],
        "kind": "m",
        "lineageTag": "a4f8b910-4c6e-4d91-9e5a-11b0c4d7e201"
      }
    ]
  }
}
